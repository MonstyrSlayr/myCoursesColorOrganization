{
    "manifest_version": 3,
    "name": "My Courses Color Organization",
    "version": "1.1",
    "description": "Allows you to assign colors to courses in RIT's MyCourses website.",
    "permissions":
    [
        "storage"
    ],
    "icons":
    {
        "40": "icons/icon-40.png",
        "80": "icons/icon-80.png",
        "160": "icons/icon-160.png"
    },
    "background":
    {
        "service_worker": "background.js",
        "scripts": ["background.js"],
        "type": "module"
    },
    "action": {},
    "content_scripts":
    [
        {
            "matches": ["https://mycourses.rit.edu/d2l/*"],
            "js": ["common.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://mycourses.rit.edu/d2l/*"],
            "js": ["topPanel.js"],
            "run_at": "document_end"
        },
        {
            "matches": ["https://mycourses.rit.edu/d2l/home"],
            "js": ["home.js"],
            "run_at": "document_end"
        },
        {
            "matches": ["https://mycourses.rit.edu/d2l/home/1*",
                            "https://mycourses.rit.edu/d2l/lms/*",
                                "https://mycourses.rit.edu/d2l/le/*",
                                    "https://mycourses.rit.edu/d2l/le/calendar/1*",
                                        "https://mycourses.rit.edu/d2l/lp/navbars/1*",
                                            "https://mycourses.rit.edu/d2l/ap/*"],
            "js": ["course.js"],
            "run_at": "document_end"
        },
        {
            "matches": ["https://mycourses.rit.edu/d2l/home/1*"],
            "js": ["courseHome.js"],
            "run_at": "document_end"
        },
        {
            "matches": ["https://mycourses.rit.edu/d2l/le/manageCourses/search/*"],
            "js": ["manageCourses.js"],
            "run_at": "document_end"
        }
    ],
    "browser_specific_settings":
    {
        "gecko":
        {
            "id": "mycourses-color-organization@example.com",
            "strict_min_version": "109.0",
            "data_collection_permissions":
            {
                "required": ["none"]
            }
        }
    }
}
